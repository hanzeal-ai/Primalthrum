# Image and listener
IMAGE_PREFIX=primalthrum
IMAGE_TAG=1.0.0
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
PUBLIC_APP_URL=https://agents.example.com

# External secret names must exist in the deployment platform before startup.
# Store the managed PostgreSQL URL in this secret; URL-encode its credentials.
DATABASE_URL_SECRET_NAME=primalthrum_database_url
DATABASE_POOL_MAX=20
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000

# OpenTelemetry collector. Headers use comma-separated URL-encoded key=value pairs.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://otel.example.com/v1/traces
OTEL_EXPORTER_OTLP_HEADERS_SECRET_NAME=primalthrum_otel_exporter_otlp_headers
OTEL_EXPORTER_OTLP_TIMEOUT=5000
OTEL_SERVER_SERVICE_NAME=primalthrum-server
OTEL_WORKER_SERVICE_NAME=primalthrum-worker
OTEL_DEPLOYMENT_ENVIRONMENT=production

# Encryption and abuse protection secrets must contain independent random values of at least 32 bytes.
PRIMALTHRUM_SECRET_KEY_SECRET_NAME=primalthrum_secret_key
ABUSE_HASH_SECRET_SECRET_NAME=primalthrum_abuse_hash_secret
# TLS proxy plus the Web proxy. Match this value to the real deployment path.
TRUSTED_PROXY_HOPS=2
FORWARDED_PROTO=https

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY_SECRET_NAME=primalthrum_turnstile_secret_key
TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
TURNSTILE_HOSTNAMES=agents.example.com

# S3-compatible object storage. Production requires an HTTPS endpoint.
OBJECT_STORAGE_ENDPOINT=https://s3.example.com
OBJECT_STORAGE_ACCESS_KEY_ID_SECRET_NAME=primalthrum_object_storage_access_key_id
OBJECT_STORAGE_SECRET_ACCESS_KEY_SECRET_NAME=primalthrum_object_storage_secret_access_key
OBJECT_STORAGE_BUCKET=primalthrum-documents
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_PREFIX=production
OBJECT_STORAGE_TIMEOUT_MS=10000

# Stripe billing
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY_SECRET_NAME=primalthrum_stripe_secret_key
STRIPE_WEBHOOK_SECRET_SECRET_NAME=primalthrum_stripe_webhook_secret
STRIPE_PRICE_PRO=price_replace
STRIPE_PRICE_TEAM=price_replace
STRIPE_PRICE_BUSINESS=price_replace
STRIPE_PRICE_ENTERPRISE=price_replace

# Transactional email. Set provider to resend or http and provide its matching credentials.
TRANSACTIONAL_EMAIL_PROVIDER=resend
TRANSACTIONAL_EMAIL_FROM=Primalthrum <noreply@example.com>
TRANSACTIONAL_EMAIL_API_KEY_SECRET_NAME=primalthrum_transactional_email_api_key
TRANSACTIONAL_EMAIL_URL=
TRANSACTIONAL_EMAIL_WEBHOOK_SECRET_SECRET_NAME=primalthrum_transactional_email_webhook_secret

# External malware scanner
CLAMAV_HOST=clamav.example.com
CLAMAV_PORT=3310

# Durable Worker
JOB_LEASE_DURATION_MS=300000
JOB_POLL_INTERVAL_MS=1000

# Optional external usage sink and one-time operator bootstrap token
USAGE_METER_EXPORT_URL=
OPERATOR_BOOTSTRAP_TOKEN_SECRET_NAME=primalthrum_operator_bootstrap_token
PROXY_TIMEOUT_MS=120000
