PORT=3000
AGENT_BASE_URL=http://127.0.0.1:8000
DOCUMENT_STORAGE_PROVIDER=local
DOCUMENT_STORAGE_DIR=../data/documents

# Production requires DOCUMENT_STORAGE_PROVIDER=s3 and an HTTPS S3-compatible endpoint.
# Store credentials in the deployment secret manager, never in source control.
# OBJECT_STORAGE_ENDPOINT=https://s3.example.com
# OBJECT_STORAGE_ACCESS_KEY_ID=replace-with-secret-manager-reference
# OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-secret-manager-reference
# OBJECT_STORAGE_SESSION_TOKEN=
# OBJECT_STORAGE_BUCKET=primalthrum-documents
# OBJECT_STORAGE_REGION=us-east-1
# OBJECT_STORAGE_PREFIX=production
# OBJECT_STORAGE_TIMEOUT_MS=10000
PUBLIC_APP_URL=http://127.0.0.1:5173

# Required when NODE_ENV=production. Keep ClamAV on the private service network;
# never expose port 3310 through the public ingress.
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=5000

# One-time Operator control-plane bootstrap. Generate 32+ random bytes and
# remove or rotate it after the first Super Admin is created at /operator.
OPERATOR_BOOTSTRAP_TOKEN=replace-with-at-least-32-random-bytes

# Public endpoint abuse protection. Generate a random 32+ byte production secret.
ABUSE_HASH_SECRET=replace-with-at-least-32-random-bytes
TRUSTED_PROXY_HOPS=0
BOT_CHALLENGE_PROVIDER=turnstile
TURNSTILE_SITE_KEY=replace_me
TURNSTILE_SECRET_KEY=replace_me
TURNSTILE_HOSTNAMES=app.example.com
# TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# Stripe test or live credentials. Never expose these to Vite variables.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_API_VERSION=
STRIPE_PRICE_PRO=price_replace_me
STRIPE_PRICE_TEAM=price_replace_me
STRIPE_PRICE_BUSINESS=price_replace_me
STRIPE_PRICE_ENTERPRISE=price_replace_me

# Optional durable external usage sink. Delivery is asynchronous and idempotent.
USAGE_METER_EXPORT_URL=https://meter.example.com/v1/events
USAGE_METER_EXPORT_TOKEN=replace_me

# Transactional email. Use resend directly or http for a compatible relay.
TRANSACTIONAL_EMAIL_PROVIDER=resend
TRANSACTIONAL_EMAIL_API_KEY=re_replace_me
TRANSACTIONAL_EMAIL_FROM=Primalthrum <no-reply@example.com>
TRANSACTIONAL_EMAIL_WEBHOOK_SECRET=whsec_replace_me

# HTTP relay alternative:
# TRANSACTIONAL_EMAIL_PROVIDER=http
# TRANSACTIONAL_EMAIL_URL=https://email.example.com/v1/messages
# TRANSACTIONAL_EMAIL_TOKEN=replace_me
