{
  "name": "server",
  "version": "1.0.0",
  "description": "Primalthrum Node API server",
  "main": "index.js",
  "scripts": {
    "backup:postgres": "ts-node src/commands/backupPostgres.ts",
    "data:transfer:postgres": "ts-node src/commands/transferSqliteToPostgres.ts",
    "dev": "nodemon --exec ts-node index.ts",
    "build": "tsc -p tsconfig.build.json",
    "restore:postgres": "ts-node src/commands/restorePostgres.ts",
    "smoke:postgres": "../scripts/postgres-smoke.sh",
    "start": "node dist/index.js",
    "test": "node --test --test-concurrency=1 --require ts-node/register tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "worker": "node dist/worker.js",
    "worker:dev": "nodemon --exec ts-node worker.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@koa/router": "^15.6.0",
    "dotenv": "^17.4.2",
    "koa": "^3.2.1",
    "koa-bodyparser": "^4.4.1",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/koa": "^3.0.3",
    "@types/koa-bodyparser": "^4.3.13",
    "@types/koa__router": "^12.0.5",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.20.4",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
